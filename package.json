{
  "name": "bm-event",
  "version": "1.2.4",
  "description": "Functionality to help you market and manage an event. From showing speakers to a live agenda for one or multiple days.",
  "private": true,
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "npm install && composer install && npm run build",
    "build": "wp-scripts build && wp-scripts build-blocks-manifest --input=blocks --output=blocks/blocks-manifest.php",
    "dev": "wp-scripts start",
    "i18n": "npm run i18n:pot",
    "i18n:pot": "npm run build && wp i18n make-pot . ./languages/bm-event.pot --exclude=node_modules,vendor,tests",
    "format": "wp-scripts format ./blocks ./assets/scripts/src",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:pkg-json",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style './assets/styles/src/**/*.scss'",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "check-engines": "wp-scripts check-engines",
    "packages-update": "wp-scripts packages-update",
    "test:unit": "wp-scripts test-unit-js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernskiold/bm-event.git"
  },
  "keywords": [
    "wordpress",
    "events",
    "blocks"
  ],
  "author": {
    "name": "Bernskiold",
    "email": "info@bernskiold.com",
    "url": "https://bernskiold.com",
    "role": "developer"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/bernskiold/bm-event/issues"
  },
  "homepage": "https://github.com/bernskiold/bm-event#readme",
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/blocks": "^17.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/core-data": "^9.1.0",
    "@wordpress/data": "^11.1.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^7.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/primitives": "^5.1.0",
    "@wordpress/scripts": "^37.1.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.14.0",
    "webpackbar": "^7.0.0"
  }
}
